# rotate-backups.sh configuration
# Sourced automatically from the script's directory at startup.
# Any value left unset falls back to the built-in default shown here.

# --- Retention ------------------------------------------------------------
# Files in DAILY_DIRNAME older than this many days are moved to ARCHIVE_DIRNAME.
MAX_BACKUP_AGE_DAYS=5

# --- Directory layout (relative to the backup dir) ------------------------
# Top-level entries dropped into the backup dir are ingested into DAILY_DIRNAME.
# Once per ISO week, the newest daily being archived is also copied into
# WEEKLY_DIRNAME so a snapshot of the previous week survives.
# Nothing is ever erased; pruned dailies go into ARCHIVE_DIRNAME and stay
# there until you remove them manually.
DAILY_DIRNAME=daily
WEEKLY_DIRNAME=weekly
ARCHIVE_DIRNAME=archive
LOGS_DIRNAME=logs
LOG_FILENAME=backups.log

# --- Slack notifications --------------------------------------------------
# Set SLACK_ENABLED=1 to post a run summary to Slack. Requires SLACK_TOKEN
# (e.g. xoxb-...) and SLACK_CHANNEL (channel id or "#name").
SLACK_ENABLED=0
SLACK_TOKEN=
SLACK_CHANNEL=

# Optional HTTPS proxy used only for the Slack API call (e.g.
# http://proxy.internal:3128). Leave blank to connect directly.
SLACK_HTTPS_PROXY=
